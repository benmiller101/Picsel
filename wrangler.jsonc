/* ---- wrangler.jsonc — how Cloudflare publishes this site ------------------
   Read by `npx wrangler deploy`, which is the deploy command Cloudflare runs
   on every push to main.

   This was an assets-only Worker with no `main` at all, and for every page on
   the site it still behaves like one: Cloudflare takes the files listed below,
   puts them on its edge, and serves them as static files.

   `main` was added in August 2026 for the two addresses that cannot be files,
   /card and /card-stats, which are the business card QR code and its scan
   readout. Cloudflare runs worker.js only when a request matches no file, so
   no page, stylesheet, screenshot or font goes anywhere near it. See worker.js
   for what it does, which is almost nothing.

   The assets directory is the repo root rather than a build output folder,
   because tools/build.js writes the generated HTML alongside the CSS and JS it
   references, and the pages link to /base.css and /hero.js at the root. That
   choice is what makes .assetsignore necessary — see the comments in it. */
{
  "name": "picsel",

  /* The router for /card and /card-stats. Nothing else reaches it. */
  "main": "worker.js",

  /* Pins the Workers runtime behaviour to how it worked on this date, so a
     future platform change cannot alter how the site is served without this
     line being edited first. */
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./",

    /* Lets worker.js hand a request it does not recognise back to the static
       files, by calling env.ASSETS.fetch(). Without this binding the two rules
       below would stop applying to anything that reached the script, and a
       typo'd address would return an empty 404 instead of the real 404 page. */
    "binding": "ASSETS",

    /* The site's routes are directories: /work/ is work/index.html on disk.
       "auto-trailing-slash" resolves those, and also sends /work to /work/ so
       the address bar matches the canonical URL in the page's own <head>
       rather than quietly serving the same page at two URLs. */
    "html_handling": "auto-trailing-slash",

    /* An unknown path gets the real 404 page in tools/pages/not-found.js,
       written to /404.html at the repo root, rather than the homepage or a
       bare blank response. A catch-all serving the homepage would mean every
       typo returns HTTP 200, which is how a site ends up with search engines
       indexing junk URLs; "none" would return an empty 404 with nothing on it
       for the real visitors CLAUDEseo section 2 says land here. "404-page"
       makes Cloudflare look for /404.html at the top of the assets directory
       and serve it, with a 404 status, for anything that matches no route. */
    "not_found_handling": "404-page"
  }

  /* ---- THE ONE THING LEFT TO DO BY HAND ----------------------------------
     Card scans are stored in a KV namespace, which is Cloudflare's key/value
     store. It has to be created on Ben's Cloudflare account, and this file
     has to be told its id, because a Worker takes its storage bindings from
     here rather than from the dashboard. A binding added in the dashboard
     would be wiped by the next deploy.

     The id is not a secret. It names a store; it does not open one. Committing
     it is normal and is how every Workers project does this.

     Create it with one command:

         npx wrangler kv namespace create CARD_SCANS

     It prints a block containing an id. Uncomment the block below, paste the
     id in, and push. Until then /card still redirects and simply counts
     nothing, which is exactly how card.js is written to behave.

  , "kv_namespaces": [
      { "binding": "CARD_SCANS", "id": "PASTE_THE_ID_HERE" }
    ]
  */
}
