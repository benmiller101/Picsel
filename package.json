{
  "name": "picsel-site",
  "version": "1.0.0",
  "private": true,
  "description": "Picsel — studio portfolio and lead-gen site. Static HTML/CSS/JS, no framework.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "dev": "npm run build && npx --yes serve . --listen 3000",
