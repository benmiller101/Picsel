{
  "name": "picsel-site",
  "version": "1.0.0",
  "private": true,
  "description": "Picsel — studio portfolio and lead-gen site. Static HTML/CSS/JS, no framework.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.js",
    "test": "node --test tools/**/*.test.js",
    "check": "npm run build && npm test && node tools/check.js",
    "dev": "npm run build && npx --yes serve dist --listen 3000",
    "shots": "node tools/capture-shots.js",
    "fonts": "node tools/fetch-fonts.js",
    "photo": "node tools/convert-photo.js",
    "backdrop": "node tools/export-backdrop.js",
    "backdrop:video": "node tools/export-backdrop-video.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "mediabunny": "^1.53.0",
    "puppeteer-core": "^25.4.0"
  }
}
