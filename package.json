    "backdrop:video": "node tools/export-backdrop-video.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "mediabunny": "^1.53.0",
    "puppeteer-core": "^25.4.0"
  }
}
