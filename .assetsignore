# What NOT to publish. Same syntax as .gitignore, read by wrangler at deploy.
#
# The assets directory is the repo root (see wrangler.jsonc), so without this
# file every source file in the project would be fetchable on picsel.co.uk:
# the planning documents, the build tooling, the client list. This is the list
# of things that live in the repo but are nobody's business on the web.
#
# The rule for editing it: if a browser is ever told to load a file, it must
# NOT appear here. Everything the pages reference is root-relative, so a wrong
# entry here shows up as a missing stylesheet on the live site and nowhere in
# local testing. Check against the src= and href= values in the built HTML.

# Dependencies. Installed on the build machine, never served.
node_modules

# The build step itself, and the data it reads. site.config.js, projects.js and
# pricing.js are imported by tools/build.js at build time only; their contents
# are already baked into the generated HTML, so publishing them serves the same
# facts twice and hands over the phone number and client list in
# machine-readable form.
#
# pricing.js is on this list even though the prices themselves are now public on
# /prices. What is not public is the commentary next to them: which plans exist
# to be undercut, why the founding offer is capped, and what the guarantee was
# written to avoid promising. That is a negotiating position, not a price list.
tools
site.config.js
projects.js
pricing.js

# noise-4d.js is imported only by the two exporters in tools/, which run in
# Node. No page loads it. Its sibling noise.js is NOT on this list and must not
# be: the hero and the backdrop both import it in the browser.
noise-4d.js

# Planning and instruction documents. plan-picsel-site.md and CLAUDE.md read as
# internal notes because they are.
*.md

# npm metadata. Reveals the toolchain, serves no visitor.
package.json
package-lock.json

# Repo and editor plumbing.
.claude
.gitattributes
.gitignore

# This file and the deploy config. Not secret, just not content.
.assetsignore
wrangler.jsonc
